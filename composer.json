{
    "name": "shopnets/ecommerce-platform",
    "description": "ShopNets E-commerce Platform",
    "type": "project",
    "require": {
        "php": "^7.4|^8.0|^8.1|^8.2",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "vlucas/phpdotenv": "^5.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0"
    },
    "autoload": {
        "psr-4": {
            "ShopNets\\": "src/"
        }
    },
    "scripts": {
        "start": "php -S 0.0.0.0:$PORT -t .",
        "post-install-cmd": [
            "php scripts/setup.php"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}