# Database Configuration
DB_HOST=localhost
DB_NAME=shopnets
DB_USERNAME=root
DB_PASSWORD=

# Production Database (for deployment)
DATABASE_URL=mysql://username:password@host:port/database_name

# Application Settings
APP_ENV=development
APP_DEBUG=true
